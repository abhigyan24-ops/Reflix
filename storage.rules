rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Locked to Cloud Functions service account
    }
    match /eco-passports/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Locked to Cloud Functions service account
    }
  }
}
